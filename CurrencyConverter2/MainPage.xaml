<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:core="clr-namespace:CurrencyConverter.Core;assembly=CurrencyConverter.Core"
             x:Class="CurrencyConverter2.MainPage"
             x:DataType="core:ConverterViewModel"
             BackgroundColor="White" Title="Конвертер валют">
    <ScrollView>
        <VerticalStackLayout Padding="12,16" Spacing="0" MaximumWidthRequest="650"
                             HorizontalOptions="Fill" VerticalOptions="Start">
            <Grid ColumnDefinitions="*,24">
                <Label Text="Конвертер валют" FontSize="29" FontAttributes="Bold"
                       TextColor="Black" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="⋮" FontSize="25" Padding="0"
                        WidthRequest="24" HeightRequest="36" BackgroundColor="Transparent"
                        TextColor="Black" Clicked="OnMenuClicked"
                        SemanticProperties.Description="Настройки сервера и обновление курсов" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto,110,28" ColumnSpacing="8" Margin="0,4,0,0">
                <Label Grid.Column="1" Text="Дата" FontSize="13" TextColor="Black"
                       VerticalOptions="Center" />
                <Border Grid.Column="2" Stroke="Black" StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 1" Padding="4,0" HeightRequest="30">
                    <DatePicker x:Name="RateDatePicker" Date="{Binding SelectedDate, Mode=TwoWay}"
                                MinimumDate="{Binding MinimumDate}" MaximumDate="{Binding MaximumDate}"
                                Format="dd.MM.yyyy" FontSize="13" TextColor="Black"
                                BackgroundColor="Transparent" HeightRequest="28" MinimumHeightRequest="0" />
                </Border>
                <ImageButton Grid.Column="3" Source="calendar.svg" Padding="0"
                             WidthRequest="26" HeightRequest="28" BackgroundColor="Transparent"
                             Clicked="OnCalendarClicked" SemanticProperties.Description="Выбрать дату курса" />
            </Grid>
            <Label Text="{Binding Status}" TextColor="Black" FontSize="13"
                   HorizontalTextAlignment="End" Margin="0,16,0,0" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               Color="Black" HeightRequest="18" HorizontalOptions="End" />
            <Grid ColumnDefinitions="1.65*,*" ColumnSpacing="10" Margin="0,26,0,0"
                  IsEnabled="{Binding HasRates}">
                <Border Stroke="Black" StrokeThickness="1.5" StrokeShape="RoundRectangle 1"
                        Padding="3,0" HeightRequest="32">
                    <Grid ColumnDefinitions="*,14">
                        <Picker x:Name="FromCurrencyPicker" Title="Валюта"
                                ItemsSource="{Binding Currencies}"
                                ItemDisplayBinding="{Binding DisplayName, x:DataType=core:CurrencyRate}"
                                SelectedItem="{Binding FromCurrency, Mode=TwoWay}"
                                FontSize="12" TextColor="Black" TitleColor="Black"
                                BackgroundColor="Transparent" HeightRequest="30" MinimumHeightRequest="0" />
                        <Label Grid.Column="1" Text="▾" TextColor="Black" FontSize="14"
                               VerticalTextAlignment="Center" HorizontalTextAlignment="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnFromCurrencyTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Stroke="Black" StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 1" Padding="4,0" HeightRequest="32">
                    <Entry Text="{Binding FromAmount, Mode=TwoWay}" Keyboard="Numeric"
                           FontSize="15" TextColor="Black" BackgroundColor="Transparent"
                           HeightRequest="30" MinimumHeightRequest="0" AutomationId="FromAmount" />
                </Border>
            </Grid>
            <Grid ColumnDefinitions="1.65*,*" ColumnSpacing="10" Margin="0,56,0,0"
                  IsEnabled="{Binding HasRates}">
                <Border Stroke="Black" StrokeThickness="1.5" StrokeShape="RoundRectangle 1"
                        Padding="3,0" HeightRequest="32">
                    <Grid ColumnDefinitions="*,14">
                        <Picker x:Name="ToCurrencyPicker" Title="Валюта"
                                ItemsSource="{Binding Currencies}"
                                ItemDisplayBinding="{Binding DisplayName, x:DataType=core:CurrencyRate}"
                                SelectedItem="{Binding ToCurrency, Mode=TwoWay}"
                                FontSize="12" TextColor="Black" TitleColor="Black"
                                BackgroundColor="Transparent" HeightRequest="30" MinimumHeightRequest="0" />
                        <Label Grid.Column="1" Text="▾" TextColor="Black" FontSize="14"
                               VerticalTextAlignment="Center" HorizontalTextAlignment="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnToCurrencyTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Stroke="Black" StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 1" Padding="4,0" HeightRequest="32">
                    <Entry Text="{Binding ToAmount, Mode=TwoWay}" Keyboard="Numeric"
                           FontSize="15" TextColor="Black" BackgroundColor="Transparent"
                           HeightRequest="30" MinimumHeightRequest="0" AutomationId="ToAmount" />
                </Border>
            </Grid>
            <Label Text="{Binding Error}" IsVisible="{Binding HasError}" TextColor="#B00020"
                   FontSize="12" Margin="0,18,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
